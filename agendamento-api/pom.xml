<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.guilhermebraga</groupId>
    <artifactId>agendamento-api</artifactId>
    <version>1.0.0</version>
    <name>agendamento-api</name>
    <description>API REST para Gestão de Agendamentos — TCC UNDB</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>

        <!-- ===== WEB (Tomcat embutido + controllers REST) ===== -->
        <!-- CORRIGIDO: era spring-boot-starter-webmvc — não existe como starter isolado -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== JPA + HIBERNATE (mapeamento objeto-relacional) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ===== VALIDATION (@Valid, @NotBlank, @Email, @Size...) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== THYMELEAF (motor de templates HTML server-side) ===== -->
        <!-- NOVO: habilita o renderizador de páginas HTML para a interface com.guilhermebraga.agendamento_api.controller.web -->
        <!-- Os controllers MVC em com.guilhermebraga.agendamento_api.controller.web/controller/ retornam o nome do template -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ===== SPRING SECURITY (autenticação e autorização) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===== JJWT (geração e validação de JSON Web Tokens) ===== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
            <version>0.12.3</version>
            <type>pom</type>
        </dependency>

        <!-- ===== SPRINGDOC — gera Swagger UI automaticamente ===== -->
        <!-- CORRIGIDO: versão 3.0.2 não existe — versão compatível é 2.8.6 -->
        <!-- Acesso: http://localhost:8081/swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- ===== DEVTOOLS (reinicia automaticamente ao salvar arquivos) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ===== H2 (banco em memória para desenvolvimento) ===== -->
        <!-- CORRIGIDO: removida spring-boot-h2console — não existe como dependência -->
        <!-- O console H2 é ativado via application.properties -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== MySQL (driver para ambiente de produção) ===== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== LOMBOK (gera código boilerplate em compile time) ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== SPRING SECURITY (autenticação e autorização da API REST) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===== TESTES (JUnit 5 + Mockito + MockMvc) ===== -->
        <!-- CORRIGIDO: as 3 dependências de teste inventadas substituídas pelo correto -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== SPRING SECURITY TEST (@WithMockUser, SecurityMockMvcRequestPostProcessors) ===== -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Empacota a aplicação em um JAR executável -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok só é necessário em compile time — excluído do JAR final -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Configura o Lombok como Annotation Processor -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>